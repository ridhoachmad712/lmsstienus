APP_NAME="LMS STIE Nusantara Makassar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SIAKAD PHP lama memiliki login dan database sendiri.
LEGACY_SIAKAD_ENABLED=false
LEGACY_SIAKAD_URL=https://siakad.example.ac.id/

# Sinkronisasi nilai akhir LMS -> database resmi SIAKAD (satu arah).
# Gunakan user MySQL khusus dengan izin SELECT pada KRS/jadwal/skala nilai dan
# UPDATE hanya pada tabel khs_mhs.
SIAKAD_GRADE_SYNC_ENABLED=false
SIAKAD_DB_CONNECTION=mysql
SIAKAD_DB_HOST=127.0.0.1
SIAKAD_DB_PORT=3306
SIAKAD_DB_DATABASE=
SIAKAD_DB_USERNAME=
SIAKAD_DB_PASSWORD=

# Backup: simpan 30 hari; BACKUP_COPY_PATH sebaiknya volume/akun terpisah.
BACKUP_RETENTION_DAYS=30
BACKUP_COPY_PATH=
BACKUP_ENCRYPTION_KEY=
SIAKAD_BACKUP_ENABLED=false

# Integrasi AI (Fase 4) — isi untuk mengaktifkan ringkasan & generate soal
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mode Demo — HANYA untuk instance demo. Biarkan false di lokal & produksi.
DEMO_MODE=false
DEMO_DOSEN_EMAIL=dosen@demo.test
DEMO_MAHASISWA_EMAIL=mahasiswa@demo.test
